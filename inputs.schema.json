{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec-Driven Platform V31 — inputs.yml schema",
  "type": "object",
  "required": ["version", "app", "tenancy", "auth", "roles", "entities", "modules", "apps", "packages", "ports", "docker", "git", "models", "vibe_test", "context7", "accessibility", "security", "deploy"],
  "properties": {
    "version": { "type": "integer", "const": 3 },
    "app": {
      "type": "object",
      "required": ["name", "slug", "purpose", "environments"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "purpose": { "type": "string", "minLength": 10 },
        "environments": {
          "type": "array",
          "items": { "type": "string", "enum": ["dev", "staging", "prod"] },
          "minItems": 3,
          "uniqueItems": true
        }
      }
    },
    "domains": {
      "type": "object",
      "required": ["prod", "staging"],
      "properties": {
        "prod": { "type": "string", "minLength": 1 },
        "staging": { "type": "string", "minLength": 1 }
      }
    },
    "tenancy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["single", "multi"] },
        "routing": { "type": "string", "enum": ["subdomain", "subdirectory"] },
        "shared_global_data": { "type": "boolean" },
        "url_pattern": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "required": ["provider", "strategy"],
      "properties": {
        "provider": { "type": "string" },
        "strategy": { "type": "string" },
        "session_type": { "type": "string", "enum": ["jwt", "database"] },
        "jwt_fields": { "type": "array", "items": { "type": "string" } },
        "mfa": { "type": "boolean" }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "scope"],
        "properties": {
          "name": { "type": "string" },
          "scope": { "type": "string", "enum": ["platform", "tenant"] },
          "description": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "properties": {
          "name": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" }, "minItems": 3 }
        }
      },
      "minItems": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url_prefix"],
        "properties": {
          "name": { "type": "string" },
          "url_prefix": { "type": "string", "pattern": "^/" }
        }
      },
      "minItems": 1
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "framework", "port"],
        "properties": {
          "name": { "type": "string" },
          "framework": { "type": "string", "enum": ["next", "expo"] },
          "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
        }
      },
      "minItems": 1
    },
    "packages": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "jobs": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "enum": ["bullmq"] },
        "queues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "retry": { "type": "integer", "minimum": 0 },
              "backoff": { "type": "string" },
              "backoff_delays": { "type": "array", "items": { "type": "integer" } },
              "dlq": { "type": "boolean" },
              "resumable": { "type": "boolean" },
              "cron": { "type": "string" }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "enum": ["minio", "s3", "r2"] },
        "max_file_size_mb": { "type": "integer", "minimum": 1 },
        "allowed_types": { "type": "array", "items": { "type": "string" } },
        "inline_processing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reporting": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "kpis": { "type": "array", "items": { "type": "string" } },
        "chart_types": { "type": "array", "items": { "type": "string" } },
        "export_formats": { "type": "array", "items": { "type": "string" } }
      }
    },
    "maps": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "navigation": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "hardcoded": { "type": "boolean" }
      }
    },
    "ports": {
      "type": "object",
      "required": ["dev"],
      "properties": {
        "dev": {
          "type": "object",
          "required": ["base", "db", "pgbouncer", "redis", "minio", "minio_console", "mailhog", "mailhog_ui", "pgadmin", "app"],
          "properties": {
            "base": { "type": "integer", "minimum": 40000, "maximum": 49999 },
            "db": { "type": "integer" },
            "pgbouncer": { "type": "integer" },
            "redis": { "type": "integer" },
            "minio": { "type": "integer" },
            "minio_console": { "type": "integer" },
            "mailhog": { "type": "integer" },
            "mailhog_ui": { "type": "integer" },
            "pgadmin": { "type": "integer" },
            "app": { "type": "integer" },
            "worker": { "type": "integer" },
            "prisma_studio": { "type": "integer" }
          }
        }
      }
    },
    "docker": {
      "type": "object",
      "required": ["publish"],
      "properties": {
        "publish": { "type": "boolean" },
        "registry": { "type": "string" },
        "hub_repo": { "type": "string" },
        "image_name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "build_on_push_to": { "type": "string" },
        "dev_build": { "type": "boolean" }
      }
    },
    "git": {
      "type": "object",
      "required": ["default_branch", "branch_pattern", "commit_style", "squash_merge"],
      "properties": {
        "default_branch": { "type": "string" },
        "branch_pattern": { "type": "string" },
        "commit_style": { "type": "string", "enum": ["conventional"] },
        "squash_merge": { "type": "boolean" },
        "use_worktrees": { "type": "boolean" }
      }
    },
    "models": {
      "type": "object",
      "required": ["planning", "execution", "governance"],
      "properties": {
        "planning": { "type": "string" },
        "execution": { "type": "string" },
        "governance": { "type": "string" }
      }
    },
    "vibe_test": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "context7": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "enum": ["none", "wcag_aa", "wcag_aaa"] }
      }
    },
    "turnstile": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "protected_pages": { "type": "array", "items": { "type": "string" } },
        "widget_mode": { "type": "string", "enum": ["managed", "non-interactive", "invisible"] }
      }
    },
    "security": {
      "type": "object",
      "required": ["data_sensitivity"],
      "properties": {
        "data_sensitivity": { "type": "string", "enum": ["low", "medium", "high"] },
        "compliance": { "type": "array", "items": { "type": "string" } },
        "audit_events": { "type": "array", "items": { "type": "string" } },
        "cors_origins": {
          "type": "object",
          "properties": {
            "dev": { "type": "string" },
            "staging": { "type": "string" },
            "prod": { "type": "string" }
          }
        },
        "rate_limiting": {
          "type": "object",
          "properties": {
            "auth": { "type": "integer" },
            "api": { "type": "integer" },
            "public": { "type": "integer" },
            "upload": { "type": "integer" }
          }
        }
      }
    },
    "smtp": {
      "type": "object",
      "properties": {
        "per_tenant": { "type": "boolean" },
        "system_fallback": { "type": "boolean" }
      }
    },
    "deploy": {
      "type": "object",
      "properties": {
        "k8s": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "komodo": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "ui_url": { "type": "string" },
            "auto_update_staging": { "type": "boolean" },
            "manual_deploy_prod": { "type": "boolean" }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "dark_mode": { "type": "string" },
        "light_mode_toggle": { "type": "boolean" },
        "accent_color": { "type": "string" },
        "tenant_configurable_accent": { "type": "boolean" },
        "banned_colors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 3
    }
  }
}
