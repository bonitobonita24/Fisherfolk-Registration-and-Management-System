# ═══════════════════════════════════════════════════════════════════
# Fisherfolk Registration and Management System — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# HOW TO USE:
# 1. Copy this file: cp .env.example .env.dev
# 2. Fill in real values (or run Phase 3 to auto-generate them)
# 3. NEVER commit .env.dev, .env.staging, or .env.prod to git
# 4. NEVER commit CREDENTIALS.md to git (it is gitignored)
#
# FIRST ADMIN ACCOUNT (created by pnpm db:seed):
#   Username: webmaster
#   Password: see CREDENTIALS.md (gitignored — generated by Bootstrap)
#   URL: http://localhost:44387/login
#
# All service passwords in CREDENTIALS.md are AI-generated strong passwords.
# Anyone cloning this repo must generate their own via Phase 3.
# ═══════════════════════════════════════════════════════════════════
COMPOSE_PROJECT_NAME=frms_dev
APP_ENV=development
APP_PORT=44387

# DOCKER HUB IMAGE (staging/prod only)
# APP_IMAGE_TAG=staging-latest
# DOCKERHUB_USERNAME=your-dockerhub-username
# IMAGE_NAME=frms

# TRAEFIK (staging/prod only)
# TRAEFIK_NETWORK=proxy
# APP_DOMAIN=your-app-domain.com

# DATABASE
DB_HOST=localhost
DB_PORT=44377
DB_NAME=frms_dev
DB_USER=your-db-user-here
DB_PASSWORD=your-db-password-here
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# PGBOUNCER
PGBOUNCER_PORT=44378
PGBOUNCER_AUTH_PASSWORD=your-pgbouncer-password-here
PGBOUNCER_DATABASE_URL=postgresql://${DB_USER}:${PGBOUNCER_AUTH_PASSWORD}@localhost:${PGBOUNCER_PORT}/${DB_NAME}

# CACHE
REDIS_HOST=localhost
REDIS_PORT=44379
REDIS_PASSWORD=your-redis-password-here
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# FILE STORAGE (MinIO — S3-compatible)
STORAGE_ENDPOINT=http://localhost:44380
STORAGE_PORT=44380
STORAGE_CONSOLE_PORT=44381
STORAGE_BUCKET=frms-dev
STORAGE_ACCESS_KEY=your-storage-access-key-here
STORAGE_SECRET_KEY=your-storage-secret-key-here
STORAGE_REGION=us-east-1

# AUTH
AUTH_SECRET=your-48-char-auth-secret-here
NEXTAUTH_URL=http://localhost:${APP_PORT}

# EMAIL (MailHog in dev — no real SMTP needed)
SMTP_HOST=localhost
SMTP_PORT=44382
SMTP_UI_PORT=44383
SMTP_FROM=dev@localhost
# SMTP_USER=your-smtp-user-here
# SMTP_PASSWORD=your-smtp-password-here
# SMTP_FROM_NAME=Fisherfolk Registration and Management System

# PGADMIN
PGADMIN_PORT=44384
PGADMIN_EMAIL=your-pgadmin-email-here
PGADMIN_PASSWORD=your-pgadmin-password-here

# CLOUDFLARE TURNSTILE (bot protection — framework default)
# These are Cloudflare's official test keys (always pass). Replace with real keys for prod.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# WORKER
WORKER_PORT=44388

# PRISMA STUDIO
PRISMA_STUDIO_PORT=44397
