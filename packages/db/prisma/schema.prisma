// ─── Custom-role permission-matrix (PD-005 Chunk 1) ────────────────────────
// Data-driven layer BELOW the fixed 3-tier system roles (tenant_manager /
// tenant_superadmin / tenant_admin — see enum UserRole). A tenant_superadmin
// (or platform tenant_manager) may define custom roles scoped to their own
// tenant; each role's capabilities are STRICTLY ≤ the tenant_admin ceiling
// and can NEVER grant billing or user-management (those FeatureKey values do
// not exist — see enum FeatureKey above). See
// ~/.claude/rules/tenant-rbac-standard.md §4 for the full spec.
model CustomRole {
  id          String    @id @default(cuid())
  // NULLABLE — tenant-scoped rows keep tenant_id set (existing behavior,
  // preserved by the default below); platform-scoped rows (scope=platform)
  // have tenant_id = NULL. Enforced by the "scope_tenant_consistency" CHECK
  // constraint hand-added to the migration (cannot be expressed natively by
  // Prisma). See docs/SITE_ACCESS_STANDARD.md §2.
  tenantId    String?   @map("tenant_id")
  scope       RoleScope @default(tenant) @map("scope")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant              Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions         RolePermission[]
  platformPermissions PlatformRolePermission[]
  users               User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("custom_roles")
}

// One row per (platform role, platform permission key) — mirrors
// RolePermission's strict CRUD split, but scoped to PlatformPermissionKey
// (the /tm platform-tier vocabulary), NOT FeatureKey. Deliberately has NO
// tenantId column — platform roles are global. See
// docs/SITE_ACCESS_STANDARD.md §2 + ~/.claude/library/tenant-rbac-standard.md.
model PlatformRolePermission {
  id            String                @id @default(cuid())
  roleId        String                @map("role_id")
  permissionKey PlatformPermissionKey @map("permission_key")
  view          Boolean               @default(false)
  write         Boolean               @default(false)
  update        Boolean               @default(false)
  delete        Boolean               @default(false)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@map("platform_role_permissions")
}

// One row per (role, feature) — a STRICT CRUD split: `write` = create-only,
// `update` = edit-only, `delete` is its own column. A custom role can be as
// narrow as view-only on a single feature.
model RolePermission {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  roleId     String     @map("role_id")
  featureKey FeatureKey @map("feature_key")
  view       Boolean    @default(false)
  write      Boolean    @default(false)
  update     Boolean    @default(false)
  delete     Boolean    @default(false)

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, featureKey])
  @@index([tenantId, roleId])
  @@map("role_permissions")
}

// ─── Telegram-storage media ledger ──────────────────────────────────────────
// The key→Telegram file-id map. Domain models (Fisherfolk.photo/signature,
// Vessel.vesselPhoto, etc.) keep holding the opaque storageKey string
// unchanged; this ledger maps that key to the Telegram document backing it
// so the domain models and their queries never need telegram_* columns.
// See docs/plans/telegram-storage-migration-plan.md §4.
model MediaObject {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  storageKey        String    @map("storage_key")
  entityType        String    @map("entity_type")
  backend           String    @default("telegram")
  telegramChatId    String?   @map("telegram_chat_id")
  telegramFileId    String?   @map("telegram_file_id")
  telegramMessageId BigInt?   @map("telegram_message_id")
  sizeBytes         Int?      @map("size_bytes")
  mimeType          String?   @map("mime_type")
  migratedAt        DateTime? @map("migrated_at")
  minioReclaimedAt  DateTime? @map("minio_reclaimed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, storageKey])
  @@index([tenantId])
  @@index([tenantId, backend])
  @@map("media_objects")
}
