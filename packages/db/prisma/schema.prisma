generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum FisherfolkStatus {
  NEW
  ACTIVE
  RENEWED
  INACTIVE
  ARCHIVED
  EXPIRED
}

enum VesselStatus {
  ACTIVE
  IMPOUNDED
  INACTIVE
}

enum ViolationStatus {
  ACTIVE
  LIFTED
  ARCHIVED
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  REQUEST
  APPROVE
  REJECT
  RENEW
  PRINT
  VIOLATION_FILED
  VIOLATION_LIFTED
  LOGIN
  EXPORT
  MEDIA_DOWNLOAD
  EXPIRE
}

enum UserRole {
  tenant_manager
  tenant_superadmin
  tenant_admin
  encoder
  viewer
  bantay_dagat
}

enum KanbanTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum KanbanTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum AyudaProgramStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AyudaBeneficiaryStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum AyudaDistributionUnit {
  FISHERFOLK
  HOUSEHOLD
}

enum Gender {
  MALE
  FEMALE
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
  DIVORCED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum ViolationTargetType {
  FISHERFOLK
  VESSEL
  BOTH
}

enum CategoryIconType {
  EMOJI
  IMAGE
}

enum CategoryStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum IDTemplateType {
  FISHERFOLK
  VESSEL
}

enum IDTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum AyudaUploadType {
  SIGNED_SHEET
  EVENT_PHOTO
  DOCUMENT
}

enum CommentTicketStatus {
  OPEN
  RESOLVED
}

enum GearType {
  GILL_NET
  HOOK_AND_LINE
  HANDLINE
  LONGLINE
  FISH_CORRAL
  FISH_TRAP
  BEACH_SEINE
  RING_NET
  CAST_NET
  LIFT_NET
  SCOOP_NET
  SPEAR_GUN
  FISH_POT
  CRAB_LIFT_NET
  SQUID_JIG
  GLEANING
  OTHER
}

enum CatchDisposition {
  SOLD
  HOME_CONSUMED
  BARTERED
  DRIED_PROCESSED
  SHARED_GIVEN
  DISCARDED
  MIXED
}

enum FishCatchSource {
  FMO_ENUMERATOR
  SELF_REPORT
  NSAP_SAMPLING
  IMPORT
}

// Custom-role permission-matrix — gateable feature registry (PD-005 Chunk 1).
// See ~/.claude/rules/tenant-rbac-standard.md §4. Deliberately EXCLUDES
// `billing` and `user_management` — those stay exclusive to the fixed
// tenant_superadmin / tenant_manager tiers and must be structurally
// impossible to grant through a custom role's permission matrix.
enum FeatureKey {
  fisherfolk
  households
  vessels
  fish_catches
  violations
  ayuda
  edit_requests
  kanban
  reports
  analytics
  map
  notifications
  id_generator
  import
  audit_log
  data_management
}

// Discriminates a CustomRole as tenant-scoped (existing custom-role system,
// gated on FeatureKey) or platform-scoped (the /tm platform-tier custom-role
// system, gated on the DISTINCT PlatformPermissionKey vocabulary below). See
// docs/SITE_ACCESS_STANDARD.md §2 + ~/.claude/library/tenant-rbac-standard.md.
enum RoleScope {
  tenant
  platform
}

// PHYSICALLY SEPARATE from FeatureKey — the platform-tier permission
// vocabulary (BILLING / TECH SUPPORT curated role sets under /tm). Deliberate
// non-overlap with FeatureKey is the anti-escalation guardrail: a platform
// custom role can never be granted a tenant-domain FeatureKey permission,
// and vice versa. See docs/SITE_ACCESS_STANDARD.md §2.
enum PlatformPermissionKey {
  billing
  tenant_management
  data_overrides
  tech_support
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Tenant {
  id                      String       @id @default(cuid())
  slug                    String       @unique
  name                    String
  // Optional vanity/custom domain. A tenant points this domain (CNAME) at our
  // app; middleware resolves the Host header to this tenant and rewrites the
  // request internally to /{slug}/... (domain masking — the browser keeps the
  // custom domain, the existing [tenant] subdirectory routes serve it).
  // Unique so one domain maps to exactly one tenant. See docs/MULTITENANCY.md.
  customDomain            String?      @unique @map("custom_domain")
  domainVerifiedAt        DateTime?    @map("domain_verified_at")
  logoUrl                 String?      @map("logo_url")
  mayorName               String?      @map("mayor_name")
  mayorSignatureUrl       String?      @map("mayor_signature_url")
  accentColor             String       @default("#4F8EF7") @map("accent_color")
  primaryColor            String       @default("#F97316") @map("primary_color")
  secondaryColor          String       @default("#1E3A5F") @map("secondary_color")
  smtpHost                String?      @map("smtp_host")
  smtpPort                Int?         @map("smtp_port")
  smtpUser                String?      @map("smtp_user")
  smtpPassword            String?      @map("smtp_password")
  smtpFrom                String?      @map("smtp_from")
  barangayList            String[]     @map("barangay_list")
  violationSubjects       String[]     @map("violation_subjects")
  currentRegistrationYear Int          @map("current_registration_year")
  status                  TenantStatus @default(ACTIVE)
  // Optional per-tenant Telegram channel override for media storage. When
  // null, uploads/reads resolve to TELEGRAM_DEFAULT_CHANNEL_ID instead. See
  // docs/plans/telegram-storage-migration-plan.md §3.
  telegramChannelId       String?      @map("telegram_channel_id")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  users                User[]
  fisherfolk           Fisherfolk[]
  vessels              Vessel[]
  violations           Violation[]
  editRequests         EditRequest[]
  comments             Comment[]
  auditLogs            AuditLog[]
  categories           Category[]
  kanbanTasks          KanbanTask[]
  notifications        Notification[]
  ayudaPrograms        AyudaProgram[]
  ayudaBeneficiaries   AyudaBeneficiary[]
  idTemplates          IDTemplate[]
  barangayAliases      BarangayAlias[]
  importBatches        ImportBatch[]
  registrationRenewals RegistrationRenewal[]
  idPrintBatches       IDPrintBatch[]
  households           Household[]
  families             Family[]
  fishCatches          FishCatch[]
  fishCatchSpecies     FishCatchSpecies[]
  customRoles          CustomRole[]
  mediaObjects         MediaObject[]

  @@map("tenants")
}

model User {
  id              String     @id @default(cuid())
  tenantId        String     @map("tenant_id")
  email           String
  username        String
  passwordHash    String     @map("password_hash")
  name            String
  role            UserRole   @default(encoder)
  status          UserStatus @default(ACTIVE)
  avatarUrl       String?    @map("avatar_url")
  securityVersion Int        @default(1) @map("security_version")
  // Optional data-driven custom role (PD-005 Chunk 1 — tenant-rbac-standard.md
  // §4). Independent of the fixed `role` tier; the effective permission
  // ceiling for a custom-role user is still capped at tenant_admin.
  customRoleId    String?    @map("custom_role_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  customRole            CustomRole?           @relation(fields: [customRoleId], references: [id])
  auditLogs             AuditLog[]
  comments              Comment[]
  kanbanTasks           KanbanTask[]
  notifications         Notification[]
  filedViolations       Violation[]           @relation("ViolationFiledBy")
  liftedViolations      Violation[]           @relation("ViolationLiftedBy")
  reviewedRequests      EditRequest[]         @relation("EditRequestReviewedBy")
  submittedRequests     EditRequest[]         @relation("EditRequestSubmittedBy")
  createdFisherfolk     Fisherfolk[]          @relation("FisherfolkCreatedBy")
  updatedFisherfolk     Fisherfolk[]          @relation("FisherfolkUpdatedBy")
  createdVessels        Vessel[]              @relation("VesselCreatedBy")
  updatedVessels        Vessel[]              @relation("VesselUpdatedBy")
  createdPrograms       AyudaProgram[]        @relation("AyudaProgramCreatedBy")
  verifiedBeneficiaries AyudaBeneficiary[]    @relation("BeneficiaryVerifiedBy")
  uploadedFiles         AyudaUpload[]
  violationAttachments  ViolationAttachment[]
  kanbanAttachments     KanbanAttachment[]
  createdTemplates      IDTemplate[]
  importBatches         ImportBatch[]         @relation("ImportBatchCreatedBy")
  renewedRegistrations  RegistrationRenewal[] @relation("RegistrationRenewalRenewedBy")
  idReleasedFisherfolk  Fisherfolk[]          @relation("FisherfolkIdReleasedBy")
  idPrintBatches        IDPrintBatch[]        @relation("IDPrintBatchPrintedBy")
  createdHouseholds     Household[]           @relation("HouseholdCreatedBy")
  fishCatchesRecorded   FishCatch[]           @relation("FishCatchRecordedBy")
  fishCatchesCreated    FishCatch[]           @relation("FishCatchCreatedBy")
  fishCatchesUpdated    FishCatch[]           @relation("FishCatchUpdatedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@map("users")
}

model Fisherfolk {
  id               String           @id @default(cuid())
  tenantId         String           @map("tenant_id")
  idNumber         String           @map("id_number")
  fullName         String           @map("full_name")
  lastName         String           @map("last_name")
  firstName        String           @map("first_name")
  middleName       String?          @map("middle_name")
  suffix           String?
  dateOfBirth      DateTime?        @map("date_of_birth") @db.Date
  sex              Gender?
  civilStatus      CivilStatus?     @map("civil_status")
  address          String
  barangay         String
  latitude         Float?           @map("latitude")
  longitude        Float?           @map("longitude")
  contactNumber    String?          @map("contact_number")
  rsbsaNumber      String?          @map("rsbsa_number")
  employmentType   EmploymentType?  @map("employment_type")
  primarySourceOfIncome String?     @map("primary_source_of_income")
  categoryIds      String[]         @map("category_ids")
  photo            String?
  signature        String?
  qrCode           String?          @map("qr_code")
  status           FisherfolkStatus @default(NEW)
  dateJoined       DateTime         @default(now()) @map("date_joined")
  registrationYear Int              @map("registration_year")
  remarks          String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  createdById      String?          @map("created_by_id")
  updatedById      String?          @map("updated_by_id")
  idReleasedAt     DateTime?        @map("id_released_at")
  idReleasedById   String?          @map("id_released_by_id")
  householdId      String?          @map("household_id")
  familyId         String?          @map("family_id")

  tenant             Tenant                @relation(fields: [tenantId], references: [id])
  createdBy          User?                 @relation("FisherfolkCreatedBy", fields: [createdById], references: [id])
  updatedBy          User?                 @relation("FisherfolkUpdatedBy", fields: [updatedById], references: [id])
  idReleasedBy       User?                 @relation("FisherfolkIdReleasedBy", fields: [idReleasedById], references: [id])
  vessels            Vessel[]              @relation("FisherfolkVessels")
  violations         Violation[]           @relation("FisherfolkViolations")
  comments           Comment[]
  editRequests       EditRequest[]
  ayudaBeneficiaries AyudaBeneficiary[]
  renewals           RegistrationRenewal[]
  household          Household?            @relation("HouseholdMembers", fields: [householdId], references: [id])
  headOf             Household?            @relation("HouseholdHead")
  fishCatches        FishCatch[]           @relation("FisherfolkFishCatches")
  family             Family?               @relation("FamilyMembers", fields: [familyId], references: [id])
  headOfFamily       Family?               @relation("FamilyHead")

  @@unique([tenantId, idNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, registrationYear])
  @@index([tenantId, barangay])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, householdId])
  @@index([tenantId, familyId])
  @@map("fisherfolk")
}

model Vessel {
  id                        String       @id @default(cuid())
  tenantId                  String       @map("tenant_id")
  mfvrNumber                String       @map("mfvr_number")
  vesselName                String?      @map("vessel_name")
  vesselType                String       @map("vessel_type")
  hullMaterial              String?      @map("hull_material")
  placeBuilt                String?      @map("place_built")
  yearBuilt                 Int?         @map("year_built")
  registeredLength          Float?       @map("registered_length")
  registeredBreadth         Float?       @map("registered_breadth")
  registeredDepth           Float?       @map("registered_depth")
  grossTonnage              Float?       @map("gross_tonnage")
  netTonnage                Float?       @map("net_tonnage")
  engineMake                String?      @map("engine_make")
  engineSerialNumber        String?      @map("engine_serial_number")
  horsepower                Float?
  homeport                  String?
  latitude                  Float?       @map("latitude")
  longitude                 Float?       @map("longitude")
  fishingGearClassification String[]     @map("fishing_gear_classification")
  vesselPhoto               String?      @map("vessel_photo")
  qrCode                    String?      @map("qr_code")
  status                    VesselStatus @default(ACTIVE)
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")
  createdById               String?      @map("created_by_id")
  updatedById               String?      @map("updated_by_id")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  createdBy   User?        @relation("VesselCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("VesselUpdatedBy", fields: [updatedById], references: [id])
  owners      Fisherfolk[] @relation("FisherfolkVessels")
  violations  Violation[]  @relation("VesselViolations")
  fishCatches FishCatch[]  @relation("VesselFishCatches")

  @@unique([tenantId, mfvrNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("vessels")
}

model Violation {
  id              String              @id @default(cuid())
  tenantId        String              @map("tenant_id")
  targetType      ViolationTargetType @map("target_type")
  fisherfolkId    String?             @map("fisherfolk_id")
  vesselId        String?             @map("vessel_id")
  subject         String
  details         String?
  evidenceImages  String[]            @map("evidence_images")
  notes           String?
  violatorName    String?             @map("violator_name")
  latitude        Float?              @map("latitude")
  longitude       Float?              @map("longitude")
  status          ViolationStatus     @default(ACTIVE)
  filedById       String              @map("filed_by_id")
  liftedById      String?             @map("lifted_by_id")
  liftedAt        DateTime?           @map("lifted_at")
  resolutionNotes String?             @map("resolution_notes")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  fisherfolk  Fisherfolk?           @relation("FisherfolkViolations", fields: [fisherfolkId], references: [id])
  vessel      Vessel?               @relation("VesselViolations", fields: [vesselId], references: [id])
  filedBy     User                  @relation("ViolationFiledBy", fields: [filedById], references: [id])
  liftedBy    User?                 @relation("ViolationLiftedBy", fields: [liftedById], references: [id])
  attachments ViolationAttachment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, fisherfolkId])
  @@index([tenantId, vesselId])
  @@index([tenantId, filedById])
  @@map("violations")
}

model EditRequest {
  id              String            @id @default(cuid())
  tenantId        String            @map("tenant_id")
  fisherfolkId    String            @map("fisherfolk_id")
  requestedById   String            @map("requested_by_id")
  fieldChanges    Json              @map("field_changes")
  status          EditRequestStatus @default(PENDING)
  reviewedById    String?           @map("reviewed_by_id")
  reviewedAt      DateTime?         @map("reviewed_at")
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  fisherfolk  Fisherfolk @relation(fields: [fisherfolkId], references: [id])
  requestedBy User       @relation("EditRequestSubmittedBy", fields: [requestedById], references: [id])
  reviewedBy  User?      @relation("EditRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, fisherfolkId])
  @@map("edit_requests")
}

model Comment {
  id               String               @id @default(cuid())
  tenantId         String               @map("tenant_id")
  fisherfolkId     String               @map("fisherfolk_id")
  authorId         String               @map("author_id")
  content          String
  mentionedUserIds String[]             @map("mentioned_user_ids")
  isTicket         Boolean              @default(false) @map("is_ticket")
  ticketStatus     CommentTicketStatus? @map("ticket_status")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  fisherfolk Fisherfolk  @relation(fields: [fisherfolkId], references: [id])
  author     User        @relation(fields: [authorId], references: [id])
  kanbanTask KanbanTask?

  @@index([tenantId])
  @@index([tenantId, fisherfolkId])
  @@map("comments")
}

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String?     @map("tenant_id")
  userId     String      @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id           String           @id @default(cuid())
  tenantId     String           @map("tenant_id")
  name         String
  description  String?
  slug         String
  displayColor String           @map("display_color")
  iconType     CategoryIconType @default(EMOJI) @map("icon_type")
  iconEmoji    String?          @map("icon_emoji")
  iconImageUrl String?          @map("icon_image_url")
  displayOrder Int              @default(0) @map("display_order")
  status       CategoryStatus   @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("categories")
}

model KanbanTask {
  id               String             @id @default(cuid())
  tenantId         String             @map("tenant_id")
  assignedToId     String             @map("assigned_to_id")
  title            String
  description      String?
  status           KanbanTaskStatus   @default(TODO)
  priority         KanbanTaskPriority @default(MEDIUM)
  sourceCommentId  String?            @unique @map("source_comment_id")
  dueDate          DateTime?          @map("due_date")
  sourceEntityType String?            @map("source_entity_type")
  sourceEntityId   String?            @map("source_entity_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  assignedTo    User               @relation(fields: [assignedToId], references: [id])
  sourceComment Comment?           @relation(fields: [sourceCommentId], references: [id])
  attachments   KanbanAttachment[]

  @@index([tenantId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("kanban_tasks")
}

model Notification {
  id         String           @id @default(cuid())
  tenantId   String           @map("tenant_id")
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, isRead])
  @@index([tenantId, userId])
  @@map("notifications")
}

model AyudaProgram {
  id               String                @id @default(cuid())
  tenantId         String                @map("tenant_id")
  title            String
  description      String?
  filters          Json
  beneficiaryCount Int                   @default(0) @map("beneficiary_count")
  status           AyudaProgramStatus    @default(DRAFT)
  distributionUnit AyudaDistributionUnit @default(FISHERFOLK) @map("distribution_unit")
  verifiedCount    Int                   @default(0) @map("verified_count")
  notReceivedCount Int                   @default(0) @map("not_received_count")
  createdById      String                @map("created_by_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  createdBy     User               @relation("AyudaProgramCreatedBy", fields: [createdById], references: [id])
  beneficiaries AyudaBeneficiary[]
  uploads       AyudaUpload[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("ayuda_programs")
}

model AyudaBeneficiary {
  id                 String                 @id @default(cuid())
  tenantId           String                 @map("tenant_id")
  programId          String                 @map("program_id")
  fisherfolkId       String                 @map("fisherfolk_id")
  verificationStatus AyudaBeneficiaryStatus @default(PENDING)
  verifiedById       String?                @map("verified_by_id")
  verifiedAt         DateTime?              @map("verified_at")
  latitude           Float?                 @map("latitude")
  longitude          Float?                 @map("longitude")
  createdAt          DateTime               @default(now()) @map("created_at")
  householdId        String?                @map("household_id")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  program    AyudaProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  fisherfolk Fisherfolk   @relation(fields: [fisherfolkId], references: [id])
  verifiedBy User?        @relation("BeneficiaryVerifiedBy", fields: [verifiedById], references: [id])
  household  Household?   @relation(fields: [householdId], references: [id])

  @@unique([programId, fisherfolkId])
  @@index([tenantId])
  @@index([programId])
  @@index([fisherfolkId])
  @@index([householdId])
  @@map("ayuda_beneficiaries")
}

model Household {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  householdNumber String   @map("household_number")
  headId          String   @unique @map("head_id")
  barangay        String
  address         String
  notes           String?
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  head               Fisherfolk         @relation("HouseholdHead", fields: [headId], references: [id])
  createdBy          User?              @relation("HouseholdCreatedBy", fields: [createdById], references: [id])
  members            Fisherfolk[]       @relation("HouseholdMembers")
  ayudaBeneficiaries AyudaBeneficiary[]
  families           Family[]

  @@unique([tenantId, householdNumber])
  @@index([tenantId])
  @@map("households")
}

model Family {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  householdId  String   @map("household_id")
  familyNumber String   @map("family_number")
