{
  "name": "@frms/db",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./audit": "./src/audit.ts",
    "./tenant-guard": "./src/middleware/tenant-guard.ts",
