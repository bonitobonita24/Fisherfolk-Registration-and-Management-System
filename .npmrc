# React Native / Expo require a hoisted node_modules layout — Metro and the RN
# native module resolver do not understand pnpm's default symlinked/isolated
# tree. This is monorepo-wide (affects apps/web too); apps/web's build is
# re-validated whenever this changes. Added for FIS-37 (apps/mobile). See
# apps/mobile/README.md.
node-linker=hoisted
