{
  "name": "frms",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:reset": "turbo run db:reset",
    "db:studio": "turbo run db:studio",
    "tools:validate-inputs": "node tools/validate-inputs.mjs",
    "tools:check-env": "node tools/check-env.mjs",
    "tools:check-product-sync": "node tools/check-product-sync.mjs",
    "tools:hydration-lint": "node tools/hydration-lint.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "undici@<7.29.0": ">=7.29.0 <8.0.0",
      "nanoid@<3.3.17": ">=3.3.17",
      "sharp@<0.35.0": ">=0.35.0",
      "fast-xml-builder@<1.1.7": ">=1.1.7",
      "vite@<6.4.3": ">=6.4.3",
      "dompurify@<3.4.11": ">=3.4.11",
      "esbuild@<0.28.1": ">=0.28.1",
      "js-yaml@<4.2.0": ">=4.2.0",
      "brace-expansion@>=5.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@1": ">=1.1.12",
      "brace-expansion@2": ">=2.1.4"
    }
  }
}
